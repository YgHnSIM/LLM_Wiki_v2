      "contained_logic_steps": [
        "L_FINALIZE"
      ],
      "next_scene_rules": [
        {
          "condition": "completion or blocker is recorded",
          "target": "END_SUCCESS"
        },
        {
          "condition": "durable state cannot be reconciled",
          "target": "END_FAIL"
        }
      ]
