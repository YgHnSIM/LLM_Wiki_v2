          "target": "S_VERIFY"
        },
        {
          "condition": "plan or audit mode has a complete read-only finding",
          "target": "S_FINALIZE"
        },
        {
          "condition": "more evidence or page context is needed",
          "target": "S_ACQUIRE"
        }
      ]
    },
    {
