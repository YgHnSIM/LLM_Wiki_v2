    {
      "scene_id": "S_FINALIZE",
      "scene_name": "Finalize and hand off",
      "scene_type": "FINALIZE",
      "scene_goal": "Make any authorized durable state match actual results, preserve state in read-only modes, and issue a self-contained next-session handoff.",
