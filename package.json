{
  "name": "llm-wiki-v2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Markdown 기반 LLM 역사 위키의 GitHub Pages 정적 사이트",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "translation:normalize": "node scripts/normalize-translation-notes.mjs --write",
    "translation:normalize:check": "node scripts/normalize-translation-notes.mjs --check",
    "source:status": "node scripts/source-workflow.mjs status",
    "source:copy": "node scripts/source-workflow.mjs copy",
    "source:ready": "node scripts/source-workflow.mjs ready",
    "math:status": "node scripts/math-network-status.mjs",
    "math:check": "node scripts/math-network-status.mjs --check",
    "math:toy": "node scripts/llm-math-toy.mjs",
    "math:shapes": "node scripts/llm-math-shapes.mjs",
    "math:capstone": "node scripts/llm-math-capstone.mjs",
    "history:status": "node scripts/llm-computing-history-status.mjs",
    "history:check": "node scripts/llm-computing-history-status.mjs --check",
    "boundary:status": "node scripts/llm-system-boundary-status.mjs",
    "boundary:check": "node scripts/llm-system-boundary-status.mjs --check",
    "boundary:resume": "node scripts/llm-system-boundary-status.mjs --resume",
    "learning:audit": "node scripts/audit-foundational-learning.mjs --write",
    "learning:audit:check": "node scripts/audit-foundational-learning.mjs --check",
    "raw:check": "node scripts/check-raw-immutability.mjs",
    "catalog:sync": "node scripts/generate-source-catalog.mjs",
    "evidence:baseline": "node scripts/generate-evidence-scope-baseline.mjs",
    "page:v3:normalize": "node scripts/normalize-page-v3.mjs",
    "sync:index": "node scripts/sync-index.mjs",
    "lint:wiki": "node scripts/lint-wiki.mjs",
    "build:site": "node scripts/build-site.mjs",
    "check:site": "node scripts/check-site.mjs",
    "test:browser": "playwright test",
    "test": "node --test scripts/tests/*.test.mjs",
    "build": "npm run lint:wiki && npm run build:site && npm run check:site",
    "verify": "npm run translation:normalize:check && npm run verify:ci",
    "verify:ci": "npm run raw:check && npm run learning:audit:check && npm run math:check && npm run history:check && npm run boundary:check && npm run test && npm run build && npm run test:browser",
    "check": "npm run verify"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^3.15.0",
    "katex": "^0.16.22",
    "marked": "^15.0.12",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
