{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YgHnSIM/LLM_Wiki_v2/wiki/meta/schemas/page-v3.schema.json",
  "title": "LLM Wiki page frontmatter v3",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "nonblank": { "type": "string", "pattern": "\\S" },
    "pageId": {
      "type": "string",
      "pattern": "^(source|reference|entity|concept|analysis|meta)\\.[\\p{L}\\p{N}]+(?:[-–·][\\p{L}\\p{N}]+)*$"
    },
    "target": { "$ref": "#/$defs/pageId" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator", "relation"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "locator": { "$ref": "#/$defs/nonblank" },
        "relation": { "enum": ["supports", "supplements", "contextualizes", "disputes"] },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["heading"],
            "properties": { "heading": { "$ref": "#/$defs/nonblank" } }
          }
        }
      }
    },
    "learningTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "reason": { "$ref": "#/$defs/nonblank" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "kind"],
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "kind": { "enum": ["related", "background", "further-reading"] },
        "note": { "$ref": "#/$defs/nonblank" }
      }
    }
  },
  "required": [
    "schema_version", "id", "page_type", "title", "aliases", "tags", "created", "updated",
    "editorial_status", "review", "artifacts", "evidence", "relations"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "id": { "$ref": "#/$defs/pageId" },
    "page_type": { "enum": ["source", "reference", "entity", "concept", "analysis", "meta"] },
    "title": { "$ref": "#/$defs/nonblank" },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonblank" }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonblank" }
    },
    "created": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" },
    "editorial_status": { "enum": ["draft", "active", "archived"] },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_coverage", "content_mode"],
      "properties": {
        "evidence_coverage": { "enum": ["unverified", "partial", "verified", "not-applicable"] },
        "content_mode": { "enum": ["descriptive", "synthesis", "contested"] },
        "reviewed_on": { "type": "string", "format": "date" }
      }
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^raw/[^/]+$" }
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["difficulty", "prerequisites", "assumed_knowledge", "outcomes", "next"],
      "properties": {
        "difficulty": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entry", "target"],
          "properties": {
            "entry": { "enum": ["foundation", "introductory", "intermediate", "advanced", "preprofessional"] },
            "target": { "enum": ["foundation", "introductory", "intermediate", "advanced", "preprofessional"] }
          }
        },
        "prerequisites": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/learningTarget" }
        },
        "assumed_knowledge": { "type": "string" },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonblank" }
        },
        "next": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/learningTarget" }
        }
      }
    },
    "relations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relation" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "page_type": { "const": "meta" } }, "required": ["page_type"] },
      "then": {
        "properties": {
          "review": { "type": "object", "properties": { "evidence_coverage": { "const": "not-applicable" } } },
          "learning": {}
        },
        "not": { "required": ["learning"], "properties": { "learning": {} } }
      },
      "else": {
        "required": ["learning"],
        "properties": {
          "evidence": { "type": "array", "minItems": 1 },
          "review": { "type": "object", "properties": { "evidence_coverage": { "not": { "const": "not-applicable" } } } }
        }
      }
    }
  ]
}
