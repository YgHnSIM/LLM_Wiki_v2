{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-wiki.local/schema/raw-artifacts-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "order_prefix", "language", "source_type", "provenance", "original_in_repository", "source_url", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^raw/[^\\\\]+$" },
          "role": { "type": "string", "minLength": 1 },
          "order_prefix": { "type": "string", "pattern": "^\\d{3}$" },
          "language": { "type": "string", "minLength": 2, "maxLength": 8 },
          "source_type": { "enum": ["primary", "secondary", "derivative"] },
          "provenance": { "type": "string", "minLength": 1 },
          "original_in_repository": { "type": "boolean" },
          "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
